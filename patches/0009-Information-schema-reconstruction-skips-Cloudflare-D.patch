From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Shenk <kevin@avu.nu>
Date: Fri, 11 Sep 2026 18:18:21 -0400
Subject: [PATCH 09/14] Information schema reconstruction skips Cloudflare D1's
 internal tables

D1 keeps "_cf_METADATA" and "_cf_KV" in the database; they are not WordPress
tables and must not be reconstructed as such.
---
 .../class-wp-sqlite-information-schema-reconstructor.php       | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/packages/mysql-on-sqlite/src/sqlite/class-wp-sqlite-information-schema-reconstructor.php b/packages/mysql-on-sqlite/src/sqlite/class-wp-sqlite-information-schema-reconstructor.php
index da05636..78b6127 100644
--- a/packages/mysql-on-sqlite/src/sqlite/class-wp-sqlite-information-schema-reconstructor.php
+++ b/packages/mysql-on-sqlite/src/sqlite/class-wp-sqlite-information-schema-reconstructor.php
@@ -135,12 +135,15 @@ class WP_SQLite_Information_Schema_Reconstructor {
 				AND name != ?
 				AND name NOT LIKE ? ESCAPE '\'
 				AND name NOT LIKE ? ESCAPE '\'
+				AND name NOT LIKE ? ESCAPE '\'
 				ORDER BY name
 			",
 			array(
 				'_mysql_data_types_cache',
 				'sqlite\_%',
 				str_replace( '_', '\_', WP_MySQL_On_SQLite::RESERVED_PREFIX ) . '%',
+				// Cloudflare D1 internal tables (e.g. "_cf_METADATA", "_cf_KV").
+				'\_cf\_%',
 			)
 		)->fetchAll( PDO::FETCH_COLUMN );
 	}
