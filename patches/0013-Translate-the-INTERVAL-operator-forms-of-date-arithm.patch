+	/**
+	 * Translate a "bitExpr" node containing "+ INTERVAL n unit" or
+	 * "- INTERVAL n unit" operations.
+	 *
+	 * The parser flattens a chain of operators into one node, so the children
+	 * are walked in order: an operand, then groups of either "<op> INTERVAL
+	 * <expr> <interval>" (a date modifier, applied to everything translated so
+	 * far) or "<op> <operand>" (ordinary arithmetic, appended as is).
+	 *
+	 * @param  WP_Parser_Node $node The "bitExpr" AST node.
+	 * @return string               The SQLite expression.
+	 */
+	private function translate_bit_expr_with_intervals( WP_Parser_Node $node ): string {
+		$children = $node->get_children();
+		$result   = $this->translate( $children[0] );
+		$compound = false;
+		$count    = count( $children );
+		for ( $i = 1; $i < $count; ) {
+			$operator = $children[ $i ];
+			if (
+				$operator instanceof WP_MySQL_Token
+				&& isset( $children[ $i + 1 ] )
+				&& $children[ $i + 1 ] instanceof WP_MySQL_Token
+				&& WP_MySQL_Lexer::INTERVAL_SYMBOL === $children[ $i + 1 ]->id
+			) {
+				$result   = $this->translate_date_arithmetic(
+					$compound ? "($result)" : $result,
+					WP_MySQL_Lexer::MINUS_OPERATOR === $operator->id ? '-' : '+',
+					$children[ $i + 2 ],
+					$children[ $i + 3 ]
+				);
+				$compound = false;
+				$i       += 4;
+				continue;
+			}
+			$result  .= ' ' . $this->translate( $operator ) . ' ' . $this->translate( $children[ $i + 1 ] );
+			$compound = true;
+			$i       += 2;
+		}
+		return $result;
+	}
+
+	/**
+	 * Translate date arithmetic -- DATE_ADD(), DATE_SUB(), "date + INTERVAL n
+	 * unit", "date - INTERVAL n unit" and "INTERVAL n unit + date" -- to a
+	 * SQLite DATETIME() modifier.
+	 *
+	 * @param  WP_Parser_Node|WP_MySQL_Token|string $date     The date expression, or its translation.
+	 * @param  string                               $sign     "+" or "-".
+	 * @param  WP_Parser_Node|WP_MySQL_Token        $value    The interval value expression.
+	 * @param  WP_Parser_Node                       $interval The "interval" AST node (the unit).
+	 * @return string                                         The SQLite expression.
+	 */
+	private function translate_date_arithmetic( $date, string $sign, $value, WP_Parser_Node $interval ): string {
+		$value = $this->translate( $value );
+		$unit  = $this->translate( $interval );
+		if ( 'WEEK' === $unit ) {
+			// In SQLite, "||" binds tighter than "*", hence the parentheses.
+			$unit  = 'DAY';
+			$value = is_numeric( $value ) ? (string) ( 7 * $value ) : sprintf( '((%s) * 7)', $value );
+		}
+		return sprintf(
+			"DATETIME(%s, '%s' || %s || ' %s')",
+			is_string( $date ) ? $date : $this->translate( $date ),
+			$sign,
+			$value,
+			$unit
+		);
+	}
+
 	/**
 	 * Translate a MySQL simple expression body to SQLite.
 	 *
@@ -5235,6 +5310,17 @@ class WP_MySQL_On_SQLite extends PDO {
 			return sprintf( '%s COLLATE BINARY', $this->translate( $expr ) );
 		}
 
+		// "INTERVAL n unit + expr" (the interval may only come first with "+").
+		if ( null !== $token && WP_MySQL_Lexer::INTERVAL_SYMBOL === $token->id ) {
+			$exprs = $node->get_child_nodes( 'expr' );
+			return $this->translate_date_arithmetic(
+				$exprs[1],
+				'+',
+				$exprs[0],
+				$node->get_first_child_node( 'interval' )
+			);
+		}
+
 		// Translate "CAST(expr AS type)" to its SQLite equivalent.
 		if ( null !== $token && WP_MySQL_Lexer::CAST_SYMBOL === $token->id ) {
 			$expr      = $node->get_first_child_node( 'expr' );
@@ -5403,18 +5489,11 @@ class WP_MySQL_On_SQLite extends PDO {
