{
    "name": "avunu/wordpress-sqlite-anywhere",
    "description": "WordPress on SQLite — local, Turso, or Cloudflare D1 over the wire. Bundles the SQLite Database Integration driver.",
    "type": "wordpress-plugin",
    "version": "1.2.0",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Avunu/wordpress-sqlite-anywhere",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.1",
        "phpunit/phpunit": "^13",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "replace": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "SqliteAnywhere\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SqliteAnywhere\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "assemble": "bin/assemble.sh",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "phpcs": "phpcs",
        "test": "phpunit",
        "check": [
            "@phpstan",
            "@phpcs",
            "@test"
        ]
    }
}
