<phpunit
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
		bootstrap="tests/bootstrap-anywhere.php"
		backupGlobals="false"
		colors="true"
		beStrictAboutTestsThatDoNotTestAnything="true"
		beStrictAboutOutputDuringTests="true"
		convertErrorsToExceptions="true"
		convertWarningsToExceptions="true"
		convertNoticesToExceptions="true"
		convertDeprecationsToExceptions="true"
		>
	<php>
		<ini name="memory_limit" value="512M"/>
	</php>
	<testsuites>
		<!-- Upstream's suites plus ours, against the local PDO backend. -->
		<testsuite name="driver">
			<directory suffix="_Tests.php">tests/</directory>
			<exclude>tests/tools</exclude>
			<exclude>tests/remote</exclude>
		</testsuite>
		<!--
			The four upstream suites the remote backends are conformance-tested
			with, as thin subclasses, against the backend WP_SQLITE_TEST_BACKEND
			names ("d1" or "turso"). The other upstream suites are pure
			translation tests that never touch a connection.
		-->
		<testsuite name="remote">
			<directory suffix="_Tests.php">tests/remote/</directory>
		</testsuite>
	</testsuites>
</phpunit>
